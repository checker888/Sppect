<% @page_title = @user.name %>
<h2>ユーザー：<%=@user.name%></h2>
<table class="attr">
  <tr>
    <th>誕生日</th>
    <td><%= @user.birthday %></td>
  </tr>
    <tr>
    <th>住所</th>
    <td><%= @user.address %></td>
  </tr>
  <tr>
    <th>電話番号</th>
    <td><%= @user.phonenumber %></td>
  </tr>

  <tr>
    <th>メールアドレス</th>
    <td><%= @user.email %></td>
  </tr>
</table>
<h3><%= link_to "ログアウト", :session,
          method: :delete, data: { confirm: "ログアウトしますか？" } %> | <%= link_to "退会", current_user, method: :delete,
              data: { confirm: "本当に退会しますか?" }  %> </h3>