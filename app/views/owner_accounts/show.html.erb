<% @page_title = @owner.name %>
<h2>オーナー：<%=@owner.name%></h2>
<table class="attr">
  <tr>
    <th>誕生日</th>
    <td><%= @owner.birthday %></td>
  </tr>
    <tr>
    <th>住所</th>
    <td><%= @owner.address %></td>
  </tr>
  <tr>
    <th>電話番号</th>
    <td><%= @owner.phonenumber %></td>
  </tr>

  <tr>
    <th>メールアドレス</th>
    <td><%= @owner.email %></td>
  </tr>
</table>
    <h3><%= link_to "オーナー情報の編集", :edit_owner_account%> | <%= menu_link_to current_owner.name + "さん", :owner_account%>
    <%= menu_link_to "ログアウト", :owner_session,
          method: :delete, data: { confirm: "ログアウトしますか？" } %>
  | <%= menu_link_to "退会", current_owner, method: :delete,
              data: { confirm: "本当に退会しますか?" } %></h3>