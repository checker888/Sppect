<%= render "shared/errors", obj: @review %>

<table class="attr">
     <tr>
    <th><%= form.label :comment%></th>
    <td><%= form.text_field :comment%></td>
  </tr>
    <tr>
    <th><%= form.label :rating %></th>
    <td><%= form.number_field :rating%></td>
  </tr>
  <tr>
    <th><%= form.label :posted_at, for: "entry_posted_at_1i" %></th>
    <td><%= form.datetime_select :posted_at,
              start_year: 2000, end_year: Time.current.year + 1,
              use_month_numbers: true %></td>
  </tr>

</table>
