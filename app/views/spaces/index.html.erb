<% @page_title = @owner ? @owner.name + "さんのスペース" : "スペース一覧" %>
<h1><%= @page_title %></h1>


<% if @spaces.present? %>
  <% @spaces.each do |space| %>
    <h2><%= space.title %></h2>
    <p><%= truncate(space.subtitle, length: 80) %>
    <%= link_to "もっと読む", space %></p>

    
  <% end %>
  <%= paginate @spaces%>
<% else %>
  <p>記事がありません。</p>
<% end %>
