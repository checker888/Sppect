<% @page_title = @space.title + " - " + @space.owner.name + "さんのスペース" %>
<h1><%= @space.owner.name %>さんのスペース</h1>
<h2><%= @space.title %></h2>
<%= link_to "予約する", new_space_reservation_path(@space) %></p>
<% if @genres.present? %>
  <% @genres.each do |genre| %>
    <%=genre.name%>
  <%end%>
<%end%>
<%=render "likes"%>
<%= simple_format(@space.detail) %>

<h2>レビュー</h2>
<%=render "reviews"%>

<% if @reviews.present? %>
  <% @reviews.each do |review| %>
    <h2><%= "#{review.user.name} ☆#{review.rating}  -#{review.posted_at}"%></h2>
    <p><%= review.comment%></p>

    
  <% end %>
  <%= paginate @reviews%>
<% else %>
  <p>レビューがありません。</p>
<% end %>


