<%= render "shared/errors", obj: @user %>

<table class="attr">
  <tr>
    <th>ユーザー名</th>
    <td><%= form.text_field :name %></td>
  </tr>
  <tr>
    <th>誕生日</th>
    <td><%= form.date_select :birthday,
              start_year: 1940, end_year: Time.current.year,
              use_month_numbers: true %></td>
  </tr>
    <tr>
    <th>住所</th>
         <% prefecture = ['北海道','青森県','岩手県','宮城県','秋田県','山形県','福島県','茨城県','栃木県','群馬県','埼玉県','千葉県','東京都','神奈川県','新潟県','富山県','石川県','福井県','山梨県','長野県','岐阜県','静岡県','愛知県','三重県','滋賀県','京都府','大阪府','兵庫県','奈良県','和歌山県','鳥取県','島根県','岡山県','広島県','山口県','徳島県','香川県','愛媛県','高知県','福岡県','佐賀県','長崎県','熊本県','大分県','宮崎県','鹿児島県','沖縄県'] %>

    <% array = [["",""]] %>

    <% prefecture.each do |i| %>
      <% array << [i, i] %>
    <% end %>

    <td><%= form.select :address,array %></td>
  </tr>
  <tr>
    <th>電話番号</th>
    <td><%= form.text_field :phonenumber %></td>
  </tr>

  <tr>
    <th>メールアドレス</th>
    <td><%= form.text_field :email %></td>
  </tr>

  <% if @user.new_record? %>
    <tr>
      <th>パスワード</th>
      <td><%= form.text_field :password %></td>
    </tr>
  <% end %>
</table>
