<% @page_title = "予約スペース一覧" %>
<h1><%= @page_title %></h1>


<% if @reservations.present? %>
  <% @reservations.each do |reservation| %>
    <h2><%= "#{reservation.space.title}  #{reservation.reserve_start_time} ~ #{reservation.reserve_end_time} "%></h2>
　　<%= link_to "予約内容を編集する", edit_space_reservation_path(reservation.space,reservation) %>
<%= link_to "予約の削除", [reservation.space,reservation], method: :delete,
              data: { confirm: "本当に削除しますか?" } %>
  <% end %>
  <%= paginate @reservations%>
<% else %>
  <p>記事がありません。</p>
<% end %>
